{
  "name": "lesson-desk",
  "version": "0.16.0",
  "private": true,
  "description": "英语与语文试卷讲解工作台",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win nsis --x64",
    "check:public": "node scripts/check-public-content.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@xmldom/xmldom": "0.8.15",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "electron": "42.11.18",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "top.rainhollow.lessondesk",
    "productName": "讲题工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-desktop/**",
      "assets/**",
      "package.json",
      "!assets/fonts/*.ttf",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "zazedwhwhy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zazedwhwhy/lesson-desk.git"
  },
  "homepage": "https://github.com/zazedwhwhy/lesson-desk#readme",
  "bugs": {
    "url": "https://github.com/zazedwhwhy/lesson-desk/issues"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.3"
    },
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
